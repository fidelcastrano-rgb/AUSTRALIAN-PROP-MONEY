# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Private API Token obtained from your Resend developer dashboard (https://resend.com)
# Used to dispatch transaction notifications securely from the server side.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: The active verified sender email address on your Resend account domain.
# Defaults to "onboarding@resend.dev" on testing sandboxes.
RESEND_FROM_EMAIL=onboarding@resend.dev

# RESEND_ADMIN_EMAIL: Real email address where administrator notifications of new orders should land.
# Defaults to "info@australianpropsmoney.com".
RESEND_ADMIN_EMAIL=info@australianpropsmoney.com

# ADMIN_PASSCODE: The secure secret word/phrase used to log into the Admin Order Desk.
# Defaults to "admin123" for testing or local access. Change this to secure your portal.
ADMIN_PASSCODE=admin123

# ADMIN_SECRET_TOKEN: The private gateway access key required to unlock the Admin Login page itself.
# To authorize your admin access, visit: /admin?token=YOUR_SECRET_TOKEN
# Defaults to "australianprop-admin-gateway" for initial setup. Keep this private.
ADMIN_SECRET_TOKEN=australianprop-admin-gateway

