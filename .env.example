# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Private API Token obtained from your Resend developer dashboard (https://resend.com)
# Used to dispatch transaction notifications securely from the server side.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: The active verified sender email address on your Resend account domain.
# Set this to your validated sender email, e.g., "sales@yourdomain.com".
RESEND_FROM_EMAIL=

# RESEND_ADMIN_EMAIL: Real email address where administrator notifications of new orders should land.
# E.g., "owner@domain.com" or "sales@australianpropsmoney.com".
RESEND_ADMIN_EMAIL=sales@australianpropsmoney.com

# ADMIN_PASSCODE: The secure secret word/phrase used to log into the Admin Order Desk.
# Defaults to "0987654321" for testing or local access. Change this to secure your portal.
ADMIN_PASSCODE=0987654321

# ADMIN_SECRET_TOKEN: The private gateway access key required to unlock the Admin Login page itself.
# To authorize your admin access, visit: /admin?token=YOUR_SECRET_TOKEN
# Defaults to "0987654321" for initial setup. Keep this private.
ADMIN_SECRET_TOKEN=0987654321

